# Copy to .env and fill in. .env is git-ignored; never commit real values.
# In Azure these come from managed identity and app settings, not from a file.

# Which adapters to use: local (files, local WebSocket, eSpeak) or azure
HTG_ENV=local

# Microsoft Foundry (day 3)
FOUNDRY_PROJECT_ENDPOINT=https://hearthegame.services.ai.azure.com/api/projects/hearthegame
FOUNDRY_MODEL=gpt-5-mini
# Reasoning models only (e.g. minimal); leave empty for non-reasoning models. Not part of the cache fingerprint.
FOUNDRY_REASONING_EFFORT=minimal

# Azure AI Speech (day 3)
SPEECH_ENDPOINT=
SPEECH_REGION=
SPEECH_KEY=
SPEECH_RESOURCE_ID=
SPEECH_VOICE_TR=tr-TR-EmelNeural
SPEECH_VOICE_EN=en-GB-SoniaNeural
# Male commentary voice (callouts, live commentator); MAI-Voice is in public preview. Copy names exactly (dotted "ı" in Aydın).
SPEECH_VOICE_COMMENTARY_EN=en-US-Ethan:MAI-Voice-2.1-Flash
SPEECH_VOICE_COMMENTARY_TR=tr-TR-Aydın:MAI-Voice-2-Flash
# Used once when a commentary clip fails (e.g. unknown voice); styles are dropped where the voice has none
SPEECH_VOICE_COMMENTARY_FALLBACK_EN=en-US-GuyNeural
SPEECH_VOICE_COMMENTARY_FALLBACK_TR=tr-TR-AhmetNeural

# Azure data plane (day 5)
EVENTHUB_NAMESPACE=
EVENTHUB_NAME=match-events
WEBPUBSUB_ENDPOINT=
WEBPUBSUB_HUB=hearthegame
COSMOS_ENDPOINT=
STORAGE_ACCOUNT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
